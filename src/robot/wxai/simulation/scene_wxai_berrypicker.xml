<!--
  The BerryPicker scene of the WidowX AI simulation. MujocoRuntime attaches
  the robot model of the exprun (mujoco_model, from the trossen_arm_mujoco
  assets) at the robot_mount frame. The robot base is at the origin, so the
  base frame of the scene is the base frame of the kinematics. The fixed
  cameras approximate the BerryPicker camera setup; their positions are
  placeholders until they are measured on the real setup.
-->
<mujoco model="berrypicker wxai">
  <option integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="2d" name="tabletop" builtin="checker" rgb1="0.55 0.45 0.35" rgb2="0.5 0.4 0.3"
      width="300" height="300"/>
    <material name="tabletop" texture="tabletop" texuniform="true" texrepeat="4 4"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="table" type="box" size="0.6 0.6 0.02" pos="0.2 0 -0.02" material="tabletop"/>
    <body name="target" pos="0.35 0.1 0.025">
      <freejoint/>
      <geom name="target" type="sphere" size="0.025" rgba="0.8 0.1 0.2 1" mass="0.05"/>
    </body>
    <frame name="robot_mount" pos="0 0 0"/>
    <camera name="front" pos="1.2 0 0.7" xyaxes="0 1 0 -0.447 0 0.894" fovy="60"/>
    <camera name="side" pos="0.3 -1.2 0.7" xyaxes="1 0 0 0 0.351 0.936" fovy="60"/>
  </worldbody>
</mujoco>
